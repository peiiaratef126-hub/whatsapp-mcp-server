# ==============================================================================
# WhatsApp Bridge (Go) Configuration
# ==============================================================================
# Port for the local-only HTTP/RPC bridge (default: 8080, binds strictly to 127.0.0.1)
WHATSAPP_BRIDGE_PORT=8080

# Logging verbosity level (DEBUG, INFO, WARN, ERROR)
WHATSAPP_LOG_LEVEL=INFO

# ==============================================================================
# WhatsApp MCP Server (Python) Configuration
# ==============================================================================
# Base URL for the Go bridge service (strictly local loopback or private host)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:8080

# HTTP request timeout in seconds for bridge API calls
WHATSAPP_REQUEST_TIMEOUT=20.0

# Maximum retry attempts on transient network errors
WHATSAPP_MAX_RETRIES=3

# PDF Extraction and Capping Limits
WHATSAPP_PDF_MAX_PAGES=10
WHATSAPP_PDF_MAX_CHARS=50000

# ==============================================================================
# Sentry Error & Performance Tracking (Optional)
# ==============================================================================
# Sentry Data Source Name (DSN) for error tracking across Go and Python
# Example: https://xxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
SENTRY_DSN=

# Deployment environment (e.g., development, staging, production)
SENTRY_ENVIRONMENT=production

# Application release identifier (e.g., whatsapp-mcp-server@1.0.0 or git commit SHA)
SENTRY_RELEASE=

# Sample rate for performance tracing transactions (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
